### Host-side environment variables used by docker-compose

# ROS 2 DDS domain ID (must match external ROS 2 containers)
ROS_DOMAIN_ID=0

# X11 display for Gazebo GUI
DISPLAY=:1

# NVIDIA (recommended for Gazebo performance)
# If you have multiple GPUs you can set a specific one (e.g. 0).
NVIDIA_VISIBLE_DEVICES=all

# Optional: select ROS 2 middleware implementation
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional: force OGRE1 if OGRE2 rendering issues
# PX4_GZ_SIM_RENDER_ENGINE=ogre
