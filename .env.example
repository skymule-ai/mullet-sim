### Host-side environment for docker compose (copied to .env by setup.sh / run.sh).
### The PX4 image is session.image in the YAML, defaulting to
### ghcr.io/skymule-ai/px4-sitl:v1.17.0 — not this file.

# ROS 2 DDS domain ID (must match any external ROS 2 process)
ROS_DOMAIN_ID=0

# X11 display for Gazebo / RViz (echo $DISPLAY)
DISPLAY=:0

# NVIDIA (recommended for Gazebo). Pick a GPU index if you have several (e.g. 0).
NVIDIA_VISIBLE_DEVICES=all

# Optional: ROS 2 middleware
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional: force OGRE1 if OGRE2 rendering issues
# PX4_GZ_SIM_RENDER_ENGINE=ogre

# Optional: pin PX4 binary used by the fleet launcher
# PX4_BIN=/opt/PX4-Autopilot/build/px4_sitl_default/bin/px4

# Optional: reset persisted per-instance PX4 parameters on startup (0/1)
# MULLET_RESET_PARAMS=0

# Optional: force `make px4_sitl_default` during container entrypoint (0/1)
# MULLET_PX4_REBUILD=0

# Optional: QGroundControl binary/AppImage when a session sets `qgc: true`
# QGC_PATH=/home/you/Apps/QGroundControl.AppImage
